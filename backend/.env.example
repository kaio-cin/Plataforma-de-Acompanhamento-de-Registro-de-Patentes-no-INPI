JWT_SECRET_KEY=troque-por-um-valor-longo-e-aleatorio
ACCESS_TOKEN_EXPIRE_MINUTES=480

# E-mail dos alertas (US11). Deixe SMTP_HOST vazio para só imprimir o e-mail no terminal.
